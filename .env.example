# 复制为 .env 并按需填写（.env 已被 .gitignore 排除，绝不要提交）

# 数据库（PostgreSQL / Neon）
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL=""

# 认证
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# LLM（二选一；配置 STEP_API_KEY 时优先使用 StepFun）
DEEPSEEK_API_KEY=""
STEP_API_KEY=""
STEP_BASE_URL="https://api.stepfun.com/step_plan/v1"
STEP_MODEL="step-3.7-flash"

# Vercel Cron / 缓存失效接口鉴权
CRON_SECRET=""

# 后台审核管理员邮箱（逗号分隔）
ADMIN_EMAILS=""
