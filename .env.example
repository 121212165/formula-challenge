# 复制为 .env 并按需填写（.env 已被 .gitignore 排除，绝不要提交）

# 数据库（PostgreSQL / Neon）
DATABASE_URL="postgresql://user:password@host:5432/formula_v2?sslmode=require"
DIRECT_URL=""

# 认证
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"

# LLM（Phase 11 启用）
DEEPSEEK_API_KEY=""
STEP_API_KEY=""
STEP_BASE_URL="https://api.stepfun.com/step_plan/v1"
STEP_MODEL="step-3.7-flash"

# Cron / 管理接口鉴权
CRON_SECRET=""
ADMIN_EMAILS=""

# ── Phase 13 生产加固 ──
# 进程内内存限流（按 IP+路由分组）。生产多实例应换 Redis 分布式限流。
# 默认 RATE_LIMIT_MAX=20 / RATE_LIMIT_WINDOW_MS=60000（窗口内请求数 / 窗口毫秒）
RATE_LIMIT_MAX="20"
RATE_LIMIT_WINDOW_MS="60000"
